{
  "name": "@alphaxiv/agents",
  "version": "0.4.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./client": "./src/client.ts",

    "./openai-responses": "./src/adapters/openai-responses.ts",
    "./openai-completions": "./src/adapters/openai-completions.ts",
    "./anthropic": "./src/adapters/anthropic/anthropic.ts",
    "./google": "./src/adapters/google.ts",
    "./lmstudio": "./src/adapters/lmstudio.ts"
  },
  "tasks": {
    "dev": "deno run --watch --env-file main.ts",
    "check": "deno fmt --check && deno lint && deno task test && deno publish --dry-run --allow-dirty",
    "test": "deno test --allow-env --allow-net=127.0.0.1"
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.67.0",
    "@google/genai": "npm:@google/genai@^1.25.0",
    "@lino/pdf-parse": "jsr:@lino/pdf-parse@^0.3.1",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/async": "jsr:@std/async@^1.0.15",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/uuid": "jsr:@std/uuid@^1.1.0",
    "openai": "npm:openai@^6.26.0",
    "zod": "npm:zod@^4.0.0"
  }
}
